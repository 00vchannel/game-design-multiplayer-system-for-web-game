{
 "$schema": "node_modules/wrangler/config-schema.json",
 "name": "my-multiplayer-game",
 "main": "worker/index.js",
 "compatibility_date": "2026-10-01",
 "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/mp/*"] },
 "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "ClassroomRoom" }] },
 "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ClassroomRoom"] }]
}
